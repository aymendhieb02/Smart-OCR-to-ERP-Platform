# Smart OCR-to-ERP Platform environment template
# Copy this file to .env for local development or pass these variables to Docker.

INVOICE_OCR_APP_NAME="Smart OCR-to-ERP Platform"
INVOICE_OCR_OUTPUT_DIR=outputs
INVOICE_OCR_MAX_UPLOAD_SIZE_MB=25

# OCR
INVOICE_OCR_OCR_LANGUAGES=fr,en
INVOICE_OCR_ENABLE_TESSERACT_FALLBACK=true
INVOICE_OCR_OCR_MODE=balanced
INVOICE_OCR_OCR_PROFILE=optimized_mobile_v4
INVOICE_OCR_ENABLE_OCR_DISK_CACHE=true
INVOICE_OCR_OCR_CACHE_DIR=.cache/ocr
INVOICE_OCR_PADDLE_USE_GPU=false
INVOICE_OCR_PADDLE_CPU_THREADS=4
INVOICE_OCR_OCR_INPUT_MAX_SIDE=1600

# Deterministic table extraction
INVOICE_OCR_TABLE_RECONSTRUCTION_PROFILE=p3_stable

# Optional ML features, disabled by default.
# Install requirements-ml.txt or build Docker with --build-arg INSTALL_ML=true before enabling.
INVOICE_OCR_ENABLE_TABLE_TRANSFORMER=false
INVOICE_OCR_ENABLE_LAYOUT_MODEL=false
INVOICE_OCR_TABLE_TRANSFORMER_DEVICE=cpu
INVOICE_OCR_LAYOUT_MODEL_DEVICE=cpu
